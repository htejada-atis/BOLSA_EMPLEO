#!groovy

pipeline {
    agent { label 'usig-jenkins'}

    environment {
    	SONAR_LOGIN = "5930772e8594b769aece20c43aa3ceb3b4f4bf24"
    	SONAR_PROYECTKEY = "${JOB_NAME}".replace("/", "-")
        APP_LISTENING_PORT = "8080"
        TEST_CONTAINER_NAME = "ci-${APP_NAME}-${BUILD_NUMBER}"
        SERVIDOR_ARGO_KUBERNETES = "jenkins.ujaen.es:5463"
        WARNING_CHECKSTYLE = "sin definir"
    }

    stages {
		stage('Compile') {
			steps {
	        	mail bcc: '', 
	            	 body: "Subida nueva version de uv-externo ${BRANCH_NAME}\n Construccion en: ${BUILD_URL}",
	             	 cc: '', from: '', replyTo: '', 
	             	 subject: "Iniciando jenkins pipeline ${JOB_NAME} (${BUILD_NUMBER}) ",
	             	 to: 'jmoral@ujaen.es'
	        	echo 'Inicio compile'
	        	git branch: "${BRANCH_NAME}", credentialsId:'gitlab-jenkins', url: "${GIT_URL}"
	        	withAnt(installation: 'LocalAnt') {
	        		sh "ant cleanall"
		            sh "ant war"
	        	}
        	}
    	}
    	stage('sidecards') {
			steps {
				echo 'Inicio unittest'
				script {
                    docker.withRegistry( 'https://usig-registrydocker.ujaen.es:5044', 'portus-jenkins' ) {
                        sh '''
                        	chmod a+x ${WORKSPACE}/Documentos/selenium/drivers/geckodriver
                            chmod a+x ${WORKSPACE}/Documentos/docker/wait-for-it.sh
                            export ORACLE_SCRIPTS_STARTUP=${WORKSPACE}/Documentos/docker/init-oracle
                            export ORACLE_DATA=/home/jenkins-nodo/oracledata
                            export ORACLE_IMAGE=usig-registrydocker.ujaen.es:5044/uvirtual/oracle/database:18.4.0-xe
                            docker-compose build
                            docker-compose up -d
                           '''
                        sleep(time:20,unit:"SECONDS")
                    }
	        	}
	        }
	    }
	    stage('Build docker') {
	    	steps {
	        	echo 'Inicio build docker'
	        	script {
                    docker.withRegistry( 'https://usig-registrydocker.ujaen.es:5044', 'portus-jenkins' ) {
    	        	    def dockerImage = docker.build("usig-registrydocker.ujaen.es:5044/uvirtual/uv-desarrollo-ci", ".") 
                        dockerImage.push()
                    }
	        	}
	        }
	    }
	    stage('analisis') {
	    	steps {
		        echo 'Inicio sonar'
		        withSonarQubeEnv('sonar docker') { 
		            withAnt(installation: 'LocalAnt') {
		               sh "ant sonar -Dsonar.projectKey=${SONAR_PROYECTKEY} -DdbUrl=127.0.0.1 -DmemcacheUrl=127.0.0.1"
		            }
		        }
	            withAnt(installation: 'LocalAnt') {
	               sh "ant checkstyle"
	               sh "ant pmd"
	            }
	        }   
	        post {
	        	always {
		        	jacoco(
					    execPattern: '**/builds/build/rama/jacoco.exec',
    					classPattern: '**/builds/build/rama/**',
    					sourcePattern: '**/src/**',
    					inclusionPattern: '**/*.class'
					)	
	        		junit 'builds/build/rama/site/jacoco/*.xml'
	        		script {
		        		def checkstyleReport = scanForIssues enabledForFailure: true, tool: checkStyle(pattern: 'builds/build/rama/site/jacoco/checkstyle_report.xml')
		        		echo "checkstyle summary ${checkstyleReport.size()} > checkstyle_log.txt"
		        		publishIssues issues: [checkstyleReport]
	        		}
	        		
	        		recordIssues enabledForFailure: true, tool: pmdParser(pattern: 'builds/build/rama/site/jacoco/pmd_report.xml')
	        	}
	        }     
	    }
	    stage('push docker') {
	    	steps {
	        	echo 'Inicio push docker'
	       	}
    	}        
    }

    post {
    	success {
            echo "-=- fin correcto -=-"
    	}
    	failure {
            echo "-=- fin ERROR -=-"
    	}
        always {
        	script {
        		def summary = junit testResults: 'builds/build/rama/site/jacoco/*.xml'
        	    sh "python3 /home/jenkins-nodo/Documentos/envioChat.py -i \"${JOB_NAME}\" -o \"resultados de las pruebas ${BRANCH_NAME} ${BUILD_NUMBER} - Total: ${summary.totalCount}, Failures: ${summary.failCount}, Skipped: ${summary.skipCount}, Passed: ${summary.passCount}\""
        	    def rutaCapturas = '/tmp/pruebasSelenium/'
        	    sh "touch builds/build/rama/site/jacoco/unittest.zip"
        	    sh "touch builds/build/rama/site/jacoco/capturas.zip"
	    		zip zipFile: 'builds/build/rama/site/jacoco/capturas.zip', archive: false, dir: "${rutaCapturas}", overwrite: true, glob: '**/*.png'
	    		zip zipFile: 'builds/build/rama/site/jacoco/unittest.zip', archive: false, dir: 'builds/build/rama/site/jacoco/', overwrite: true, glob: '**/*.txt'
        	}
        	def checkstyleLog = readFile('checkstyle_log.txt').trim()
			emailext mimeType: "text/html", to: 'jmoral@ujaen.es',
				attachLog: true, attachmentsPattern: 'builds/build/rama/site/jacoco/unittest.zip, builds/build/rama/site/jacoco/capturas.zip',
				body: "Construccion en: ${BUILD_URL}\n ${checkstyleLog}", 
				subject: "Completado jenkins pipeline ${JOB_NAME} (${BUILD_NUMBER}) "
    		sh "docker-compose down || true"
            echo "-=- fin -=-"
        }
    }
}